{
  "name": "nuvio-fr-plugin",
  "version": "1.8.5",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node scripts/build.cjs --check && node --test tests/*.test.cjs",
    "test:live": "python3 scripts/verify_live.py --runtime both --report live-report.json",
    "build": "node scripts/build.cjs",
    "check:build": "node scripts/build.cjs --check",
    "test:quickjs": "python3 scripts/quickjs_check.py --all --runtime both",
    "audit": "python3 scripts/audit.py",
    "audit:deep": "python3 scripts/audit.py --profile deep"
  },
  "engines": {
    "node": ">=18"
  }
}
